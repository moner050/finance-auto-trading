# Copy to .env beside compose.yaml. Nothing here has a default that would let
# the stack start against the wrong database or as the wrong operator.

# --- where the data lives -------------------------------------------------
# Point these at whatever you already run. To use the bundled MySQL and Redis
# instead, start with `--profile local-data` and use the localhost URLs below.
DATABASE_URL=mysql+aiomysql://user:password@db.example.com:3306/finance_auto_trading_prod
REDIS_URL=redis://:password@redis.example.com:6379/0

# --- the back office ------------------------------------------------------
# The domain browsers reach it at. This is what Caddy obtains a certificate
# for and what must be registered with Google as the redirect origin.
BACKOFFICE_DOMAIN=backoffice.example.com
CADDY_ACME_EMAIL=operator@example.com

# The one operator. Any other verified email is refused.
BACKOFFICE_ALLOWED_EMAIL=operator@example.com

# The account the dashboard reports on. Named rather than guessed, because a
# dashboard that picks an account is a dashboard that can show the wrong one.
BACKOFFICE_ACCOUNT_ID=00000000-0000-7000-8000-000000000000

# 32 bytes, base64. The key every stored secret is sealed with; losing it
# loses them. The OAuth client id and secret are read from the database, not
# from here.
BACKOFFICE_MASTER_KEY=
BACKOFFICE_MASTER_KEY_VERSION=1

# --- the daily capture ----------------------------------------------------
# UTC hour to record the previous day. After the day has closed, not at the
# boundary, so a venue a few minutes late still counts.
CAPTURE_HOUR=1

# --- the shadow loop ------------------------------------------------------
# The account the loop evaluates against, and the report that says what it is
# missing (`docker compose --profile check run --rm trader-check`).
#
# The loop places no orders. It reads real bars against this real account,
# records decisions, and collects the aggregate-trade tape.
TRADER_ACCOUNT_ALIAS=
# Not read from the venue: it is on no position the venue reports.
TRADER_LEVERAGE=3

# --- bundled MySQL and Redis, only with --profile local-data --------------
MYSQL_PORT=3306
REDIS_PORT=6379
MYSQL_PASSWORD=local-development-only
MYSQL_ROOT_PASSWORD=local-root-development-only
# DATABASE_URL=mysql+aiomysql://autotrader:local-development-only@mysql:3306/finance_auto_trading
# REDIS_URL=redis://redis:6379/0

# --- build labels ---------------------------------------------------------
# Stamped onto the image so a running container can be traced to a commit.
GATE_COMMIT_SHA=unknown
GATE_MIGRATION_HEAD=unknown
GATE_OFFICIAL_FACT_REGISTRY_SHA256=unknown
